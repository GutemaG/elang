# Copy to `.env.local` for local runs. Both values end up in the browser
# bundle, so nothing secret belongs here.

# The Buna backend (no trailing slash). Local: the uvicorn dev server.
VITE_API_BASE_URL=http://localhost:8000

# The Google OAuth *web* client id -- the same one the backend accepts as
# GOOGLE_OAUTH_CLIENT_ID. Public by design.
VITE_GOOGLE_CLIENT_ID=475970937717-h80aqt3b2b7psrt918udc102r6ts61fq.apps.googleusercontent.com
