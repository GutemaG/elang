# Copy this file to `.env` and fill in real values for your environment.
# Never commit `.env` with real secrets.

# local | staging | production -- controls log format (human-readable vs JSON)
ENVIRONMENT=local

# Local dev/test default: SQLite via aiosqlite (data-stack.md).
# Real deployment target: PostgreSQL via asyncpg, e.g.
#   postgresql+asyncpg://user:password@host:5432/buna
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Google OAuth: the client ID your backend validates the ID token's
# audience against (google-auth's verify_oauth2_token).
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Sign in with Apple: Services ID (web) / bundle ID (native), Team ID, and
# Key ID from your Apple Developer account. Team ID / Key ID are reserved
# for a future server-to-server Apple flow (e.g. token revocation webhooks);
# not required for identity-token verification itself, which only needs the
# audience values below.
APPLE_SERVICES_ID=com.example.buna.service
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_BUNDLE_ID=com.example.buna

APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_ISSUER=https://appleid.apple.com

# Session token lifetime, in days.
SESSION_TTL_DAYS=30

# Comma-separated extra CORS origins (e.g. a deployed web app's real
# domain). A * stands for one name: https://*.vercel.app allows every Vercel
# site, including the admin site's preview deployments. In local dev, any
# http://localhost:<port> origin is already allowed regardless of this
# value -- see `app/main.py`.
CORS_ALLOWED_ORIGINS=

# Comma-separated Google account emails allowed into the content admin API
# (/api/v1/admin/*). Matched against the Google-verified email saved at each
# sign-in; empty means nobody is an admin. Set on Vercel too.
ADMIN_EMAILS=

# How long the in-memory Apple JWKS cache is considered fresh before a
# routine refresh (independent of the refetch-once-on-unknown-kid fallback).
APPLE_JWKS_CACHE_TTL_SECONDS=3600

# Recorded lesson audio (Cloudflare R2). AUDIO_BASE_URL is the bucket's
# public address; saved clips are `<AUDIO_BASE_URL>/<key>`. Locally,
# `/media/audio` serves backend/media instead (the Audio Lab).
AUDIO_BASE_URL=https://pub-your-bucket-id.r2.dev

# Sign the admin site's upload links (bolt 036). Set on Vercel too: they stay
# server-side and are never sent to a browser. From R2 -> Manage API tokens
# -> Create API token (Object Read & Write, this bucket only).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
